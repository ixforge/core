# IXForge Core Configuration
IXFORGE_DATABASE_URL=postgresql+asyncpg://ixforge:ixforge@localhost:5432/ixforge
IXFORGE_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
IXFORGE_DEBUG=true

# Optional
# IXFORGE_CORS_ORIGINS=["http://localhost:3000"]
# IXFORGE_RATE_LIMIT_PER_MINUTE=60

# Portal servido por HTTP en red interna: deshabilitar cookie Secure
# IXFORGE_UI_SECURE_COOKIES=false

# Portal (proceso ixforge ui)
# IXFORGE_UI_PORT=8001
# IXFORGE_CORE_URL=http://localhost:8000   # URL del Core que el portal consume

# Almacenamiento de archivos subidos (logos de miembros)
# IXFORGE_MEDIA_ROOT=./media
# IXFORGE_MEDIA_URL=/media

# Feature flags de modulos (default: solo ixf_export activo)
# IXFORGE_MODULE_UI=true
# IXFORGE_MODULE_SWITCHING=true
# IXFORGE_MODULE_RPKI=true
# IXFORGE_MODULE_PEERINGDB_SYNC=true
# IXFORGE_MODULE_IXF_EXPORT=true
