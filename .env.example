# IXForge Core Configuration
IXFORGE_DATABASE_URL=postgresql+asyncpg://ixforge:ixforge@localhost:5432/ixforge
IXFORGE_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
IXFORGE_DEBUG=true

# Optional
# IXFORGE_CORS_ORIGINS=["http://localhost:3000"]
# IXFORGE_RATE_LIMIT_PER_MINUTE=60
# Portal servido por HTTP en red interna: deshabilitar cookie Secure
# IXFORGE_UI_SECURE_COOKIES=false
