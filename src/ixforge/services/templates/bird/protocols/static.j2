{% if af == 4 %}
protocol static blackhole_v4 {
    ipv4 { preference 0; };
    # Blackhole routes for prefix filtering
    {% for route in blackhole_routes_v4 | default([]) %}
    route {{ route }} blackhole;
    {% endfor %}
}
{% endif %}

