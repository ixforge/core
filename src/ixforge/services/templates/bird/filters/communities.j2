# BGP community filters for IXForge route servers
# Generated by IXForge Core - do not edit manually

{% if af == 4 %}
# Informational communities (RFC 8326 / RFC 7999)
define IXP_ASN = {{ route_server.asn }};

# Graceful shutdown (RFC 8326)
define GRACEFUL_SHUTDOWN = (65535, 0);

# Blackhole (RFC 7999)
define BLACKHOLE_COMMUNITY = (65535, 666);

# honor_graceful_shutdown() is defined in functions/common.j2

function is_blackhole_request() {
    if (BLACKHOLE_COMMUNITY ~ bgp_community) then return true;
    return false;
}
{% endif %}

